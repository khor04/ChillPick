# TMDB - movies. Get a key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Google Books - Discover page book list. Keep the ?q=... part: the app adds &startIndex=... to it.
# Get a key: https://console.cloud.google.com/apis/credentials (enable "Books API")
GOOGLE_BOOKS_API=https://www.googleapis.com/books/v1/volumes?q=subject:fiction&key=your_google_books_api_key
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# NYT Books - bestseller lists. Get a key: https://developer.nytimes.com/
NYT_BOOKS_API_KEY=

# MongoDB Atlas connection string
MONGODB_URI=
SESSION_SECRET=

# Email: Brevo is used when BREVO_API_KEY is set; otherwise Gmail SMTP (EMAIL_USER/EMAIL_PASS)
BREVO_API_KEY=
MAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# Public site URL, used in email links (e.g. https://your-app.onrender.com)
CLIENT_URL=

# ImageKit - profile pictures
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
